#!@PYTHON@

import os
import sys

# Ensure the installed module path is in sys.path if installed to a custom prefix or flatpak
pythondir = '@PYTHON_DIR@'
if pythondir and pythondir not in sys.path:
    sys.path.insert(0, pythondir)

