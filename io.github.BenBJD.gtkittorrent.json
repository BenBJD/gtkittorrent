{
  "app-id": "io.github.BenBJD.gtkittorrent",
  "runtime": "org.gnome.Platform",
  "runtime-version": "51",
  "sdk": "org.gnome.Sdk",
  "command": "gtkittorrent",
  "finish-args": [
    "--share=network",
    "--share=ipc",
    "--socket=fallback-x11",
    "--socket=wayland",
    "--filesystem=xdg-config/qBittorrent",
    "--filesystem=xdg-download"
  ],
  "modules": [
    "python3-qbittorrent-api.json",
    {
      "name": "gtkittorrent",
      "buildsystem": "meson",
      "builddir": true,
      "sources": [
        {
          "type": "dir",
          "path": "."
        }
      ]
    }
  ]
}