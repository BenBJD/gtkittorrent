# Maintainer: Ben Davison
pkgname=gtkittorrent
pkgver=1.0.0
pkgrel=1
pkgdesc="Modern GTK4 and Libadwaita frontend for qBittorrent"
arch=('any')
url="https://github.com/BenBJD/gtkittorrent"
license=('GPL-3.0-or-later')
depends=(
    'gtk4'
    'libadwaita'
    'python'
    'python-gobject'
    'python-qbittorrent-api'
)
makedepends=('git')
source=(
    "$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz"
    "io.github.BenBJD.gtkittorrent.desktop"
)
sha256sums=('SKIP'
            'SKIP')

package() {
    cd "$srcdir"

    # Install application files
    install -dm755 "$pkgdir/usr/share/gtkittorrent"
    if [ -d "$srcdir/$pkgname-$pkgver" ]; then
        cp -r "$srcdir/$pkgname-$pkgver"/* "$pkgdir/usr/share/gtkittorrent/"
    fi

    # Install launcher script
    install -dm755 "$pkgdir/usr/bin"
    cat << 'EOF' > "$pkgdir/usr/bin/gtkittorrent"
#!/bin/sh
exec python3 /usr/share/gtkittorrent/main.py "$@"
EOF
    chmod 755 "$pkgdir/usr/bin/gtkittorrent"

    # Install desktop files
    install -Dm644 "$srcdir/io.github.BenBJD.gtkittorrent.desktop" \
        "$pkgdir/usr/share/applications/io.github.BenBJD.gtkittorrent.desktop"

    # Install application icons
    if [ -d "$srcdir/$pkgname-$pkgver/data/icons" ]; then
        install -Dm644 "$srcdir/$pkgname-$pkgver/data/icons/hicolor/scalable/apps/io.github.BenBJD.gtkittorrent.svg" \
            "$pkgdir/usr/share/icons/hicolor/scalable/apps/io.github.BenBJD.gtkittorrent.svg"
        install -Dm644 "$srcdir/$pkgname-$pkgver/data/icons/hicolor/symbolic/apps/io.github.BenBJD.gtkittorrent-symbolic.svg" \
            "$pkgdir/usr/share/icons/hicolor/symbolic/apps/io.github.BenBJD.gtkittorrent-symbolic.svg"
    fi
}
